HOST=0.0.0.0
PORT=1340
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Production behind Nginx: PUBLIC_URL=https://admin.topwelltea.com and IS_PROXIED=true
# PUBLIC_URL=
# IS_PROXIED=false

# Shared with frontend/.env.local (SHOP_API_SECRET)
SHOP_API_SECRET=tobemodified
SEED_DATA=true
CORS_ORIGINS=http://localhost:3010

# Next.js cache refresh webhook (must match frontend REVALIDATE_SECRET)
FRONTEND_URL=http://localhost:3010
REVALIDATE_SECRET=tobemodified

# Email (order confirmations, contact notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=
# SMTP_PASSWORD=
EMAIL_FROM=no-reply@topwelltea.com
EMAIL_REPLY_TO=hello@topwelltea.com
# Without SMTP_HOST: log emails to the console instead of sending (development)
EMAIL_PREVIEW=true

