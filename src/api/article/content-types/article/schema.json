{
  "kind": "collectionType",
  "collectionName": "articles",
  "info": {
    "singularName": "article",
    "pluralName": "articles",
    "displayName": "Bài viết"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::article-category.article-category"
    },
    "excerpt": {
      "type": "text"
    },
    "mobileExcerpt": {
      "type": "text"
    },
    "cover": {
      "type": "component",
      "component": "shared.image",
      "repeatable": false
    },
    "author": {
      "type": "string"
    },
    "publishedDate": {
      "type": "date"
    },
    "readingTime": {
      "type": "string"
    },
    "content": {
      "type": "blocks"
    },
    "tags": {
      "type": "component",
      "component": "shared.tag",
      "repeatable": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
