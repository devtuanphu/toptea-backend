{
  "kind": "singleType",
  "collectionName": "article_page",
  "info": {
    "singularName": "article-page",
    "pluralName": "article-pages",
    "displayName": "Trang chi tiết bài viết (chung)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "relatedTitle": {
      "type": "string"
    },
    "relatedCount": {
      "type": "integer",
      "default": 3,
      "min": 0,
      "max": 12
    },
    "readMoreLabel": {
      "type": "string"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.page-banner",
        "sections.split-story",
        "sections.image-band",
        "sections.quote-band",
        "sections.cta-band",
        "sections.newsletter",
        "sections.card-grid",
        "sections.faq"
      ]
    }
  }
}
