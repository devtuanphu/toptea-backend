{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Sản phẩm"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "sku": {
      "type": "string"
    },
    "category": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product-category.product-category"
    },
    "brewMethods": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::brew-method.brew-method"
    },
    "price": {
      "type": "integer",
      "required": true,
      "min": 0
    },
    "inStock": {
      "type": "boolean",
      "default": true
    },
    "shortDescription": {
      "type": "text"
    },
    "subtitle": {
      "type": "string"
    },
    "sizeLabel": {
      "type": "string"
    },
    "badge": {
      "type": "string"
    },
    "cardNote": {
      "type": "string"
    },
    "mobileShortDescription": {
      "type": "text"
    },
    "mobileCardNote": {
      "type": "string"
    },
    "images": {
      "type": "component",
      "component": "shared.image",
      "repeatable": true
    },
    "keyMessage": {
      "type": "component",
      "component": "product.key-message",
      "repeatable": false
    },
    "highlight": {
      "type": "component",
      "component": "shared.icon-text",
      "repeatable": false
    },
    "specs": {
      "type": "component",
      "component": "shared.spec-row",
      "repeatable": true
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "product.brew-guides",
        "product.usage-steps",
        "sections.page-banner",
        "sections.split-story",
        "sections.image-band",
        "sections.quote-band",
        "sections.cta-band",
        "sections.newsletter",
        "sections.card-grid",
        "sections.faq"
      ]
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "seo": {
      "type": "component",
      "component": "shared.seo",
      "repeatable": false
    }
  }
}
