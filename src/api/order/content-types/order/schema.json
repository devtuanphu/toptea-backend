{
  "kind": "collectionType",
  "collectionName": "orders",
  "info": {
    "singularName": "order",
    "pluralName": "orders",
    "displayName": "Đơn hàng"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "code": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "orderStatus": {
      "type": "enumeration",
      "enum": [
        "pending",
        "confirmed",
        "shipping",
        "completed",
        "cancelled"
      ],
      "default": "pending"
    },
    "customerName": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "email",
      "required": true
    },
    "phone": {
      "type": "string",
      "required": true
    },
    "address": {
      "type": "string",
      "required": true
    },
    "province": {
      "type": "string"
    },
    "district": {
      "type": "string"
    },
    "note": {
      "type": "text"
    },
    "paymentMethod": {
      "type": "string"
    },
    "items": {
      "type": "json"
    },
    "subtotal": {
      "type": "integer"
    },
    "shippingFee": {
      "type": "integer"
    },
    "total": {
      "type": "integer"
    },
    "carrier": {
      "type": "string"
    },
    "estimatedDelivery": {
      "type": "date"
    },
    "history": {
      "type": "component",
      "component": "commerce.status-event",
      "repeatable": true
    },
    "paymentStatus": {
      "type": "enumeration",
      "enum": [
        "unpaid",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "unpaid"
    },
    "paymentRef": {
      "type": "string"
    },
    "paidAt": {
      "type": "datetime"
    }
  }
}
